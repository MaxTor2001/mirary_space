<%- include('partials/header') %>

<h1 class="page-title">Мои заказы</h1>

<% if (!orders.results.length) { %>
  <p class="empty">Заказов пока нет. <a href="/catalog">Выбрать украшения</a></p>
<% } else { %>
  <table class="table">
    <thead><tr><th>Номер</th><th>Дата</th><th>Статус</th><th>Сумма</th><th></th></tr></thead>
    <tbody>
      <% orders.results.forEach(function (order) { %>
        <tr>
          <td>№<%= order.id %></td>
          <td><%= new Date(order.created_at).toLocaleString('ru-RU') %></td>
          <td><span class="status status--<%= order.status %>"><%= order.status_display %></span></td>
          <td><%= price(order.total_price) %></td>
          <td><a class="link" href="/orders/<%= order.id %>">подробнее</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('partials/footer') %>
