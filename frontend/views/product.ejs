<%- include('partials/header') %>

<nav class="breadcrumbs">
  <a href="/catalog">Каталог</a> / <a href="/catalog?category=<%= product.category.slug %>"><%= product.category.name %></a>
</nav>

<div class="product">
  <div class="product__image">
    <% if (product.image) { %>
      <img src="<%= product.image %>" alt="<%= product.name %>">
    <% } else { %>
      <span class="card__mark card__mark--big"><%= product.name.charAt(0) %></span>
    <% } %>
  </div>
  <div class="product__info">
    <h1><%= product.name %></h1>
    <div class="prices prices--big">
      <span class="price"><%= price(product.sell_price) %></span>
      <% if (Number(product.discount) > 0) { %><s class="price price--old"><%= price(product.price) %></s><% } %>
    </div>
    <dl class="specs">
      <div><dt>Материал</dt><dd><%= product.material || '—' %></dd></div>
      <% if (product.thicknesses.length) { %>
        <div><dt>Толщина</dt><dd><%= sizes(product.thicknesses) %> мм</dd></div>
      <% } %>
      <% if (product.lengths.length) { %>
        <div><dt>Длина</dt><dd><%= sizes(product.lengths) %> мм</dd></div>
      <% } %>
      <% if (product.thread) { %>
        <div><dt>Резьба</dt><dd><%= product.thread_display %></dd></div>
      <% } %>
      <div><dt>Наличие</dt><dd><%= product.quantity ? product.quantity + ' шт' : 'нет в наличии' %></dd></div>
    </dl>
    <p class="product__description"><%= product.description %></p>
    <form class="product__buy" action="/cart/add" method="post">
      <input type="hidden" name="product_id" value="<%= product.id %>">
      <input type="hidden" name="next" value="/product/<%= product.slug %>">
      <% if (product.thicknesses.length) { %>
        <label class="product__choice">Толщина
          <select class="input" name="thickness" required>
            <% product.thicknesses.forEach((value) => { %>
              <option value="<%= value %>"><%= Number(value) %> мм</option>
            <% }) %>
          </select>
        </label>
      <% } %>
      <% if (product.lengths.length) { %>
        <label class="product__choice">Длина
          <select class="input" name="length" required>
            <% product.lengths.forEach((value) => { %>
              <option value="<%= value %>"><%= Number(value) %> мм</option>
            <% }) %>
          </select>
        </label>
      <% } %>
      <input class="input input--qty" type="number" name="quantity" value="1" min="1" max="<%= product.quantity || 1 %>">
      <button class="btn" <%= product.quantity ? '' : 'disabled' %>>В корзину</button>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
