<%- include('partials/header') %>
<h1 class="page-title">Доставка и оплата</h1>
<p class="lead">Удобные способы получить и оплатить заказ</p>

<section class="section">
  <h2 class="section__title">Способы доставки</h2>
  <div class="grid">
    <% delivery.shipping.forEach((option) => { %>
      <article class="card">
        <div class="card__body">
          <h3 class="card__title"><%= option.title %></h3>
          <p class="card__meta"><%= option.terms %></p>
          <p class="card__meta"><strong><%= option.price %></strong></p>
        </div>
      </article>
    <% }) %>
  </div>
</section>

<section class="section">
  <h2 class="section__title">Способы оплаты</h2>
  <ul class="list">
    <% delivery.payment.forEach((method) => { %>
      <li><%= method %></li>
    <% }) %>
  </ul>
</section>

<section class="section">
  <h2 class="section__title">Возврат и обмен</h2>
  <p class="muted"><%= delivery.returns %></p>
  <p class="muted">По вопросам возврата свяжитесь с нами на странице <a href="/contacts">контактов</a>.</p>
</section>
<%- include('partials/footer') %>
