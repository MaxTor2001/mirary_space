# Витрина Mirari за nginx. Установка на сервере:
#   sudo cp mirari.conf /etc/nginx/sites-available/mirari.conf
#   sudo sed -i 's/SHOP_DOMAIN/ваш-домен.ru/g' /etc/nginx/sites-available/mirari.conf
#   sudo ln -s /etc/nginx/sites-available/mirari.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d ваш-домен.ru -d www.ваш-домен.ru
#
# Блок именной (server_name), без default_server — конфиги соседних сайтов
# на этом же nginx не затрагиваются, certbot допишет ssl только в этот файл.
server {
    listen 80;
    listen [::]:80;
    server_name SHOP_DOMAIN www.SHOP_DOMAIN;

    client_max_body_size 10M;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
