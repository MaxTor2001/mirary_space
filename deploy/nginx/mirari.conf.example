# Витрина Mirari за nginx.
#   / .............. витрина Express (127.0.0.1:8080)
#   /admin/ ........ админка Django (127.0.0.1:8000)
#   /static/ ....... статика Django, нужна админке (её раздаёт whitenoise)
#
# Блок именной (server_name), без default_server — конфиг соседнего сайта
# на этом же nginx не затрагивается.
server {
    server_name mirari.space www.mirari.space;

    client_max_body_size 10M;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ВАШ-СЕКРЕТНЫЙ-ПУТЬ/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Картинки товаров — прямо с диска, мимо Python.
    location /media/ {
        alias /home/deploy/mirari-media/;
        expires 30d;
        access_log off;
    }

    location /static/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/mirari.space/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/mirari.space/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = www.mirari.space) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = mirari.space) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name mirari.space www.mirari.space;
    return 404; # managed by Certbot
}
