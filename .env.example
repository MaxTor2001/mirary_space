# Скопируйте в .env и поменяйте значения для production

# На сервере обязательно: без этого docker compose без флагов поднимет
# dev-конфигурацию с открытым наружу Postgres. Локально не нужно.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
POSTGRES_DB=mirari
POSTGRES_USER=mirari
POSTGRES_PASSWORD=mirari
POSTGRES_PORT_HOST=5432

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=
BACKEND_PORT=8000
SEED_DEMO=1
# Пароль администратора для seed_demo; без него будет admin/admin
DJANGO_ADMIN_PASSWORD=change-me
# Адрес админки. На проде задайте неугадываемый путь и тот же путь укажите
# в ADMIN_URL и в location nginx. Слеш в конце обязателен.
DJANGO_ADMIN_PATH=admin/
ADMIN_URL=/admin/

# Реквизиты продавца (показываются на страницах «О магазине» и «Контакты»)
SHOP_LEGAL_NAME=ИП Канищева Екатерина Владимировна
SHOP_INN=745110010453

# Онлайн-оплата ЮKassa. Пока ключи пустые, на сайте остаётся оплата при получении.
# Тестовые ключи начинаются с test_, боевые — с live_.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Чек по 54-ФЗ: 0, если облачная касса ещё не подключена
YOOKASSA_SEND_RECEIPT=1
# Ставка НДС в чеке: 1 — без НДС (обычный вариант для ИП на УСН)
YOOKASSA_VAT_CODE=1
# Система налогообложения: заполнять, только если у кассы их несколько (2 — УСН доходы)
YOOKASSA_TAX_SYSTEM_CODE=

SESSION_SECRET=change-me
FRONTEND_PORT=3000

# Только для docker-compose.prod.yml: порт витрины, интерфейс и Secure-куки за nginx
SHOP_PUBLIC_PORT=8080
SHOP_BIND=127.0.0.1
SECURE_COOKIES=1

# SEO: абсолютный адрес сайта, счётчик Метрики, подтверждения владения, ключ IndexNow
SITE_URL=https://mirari.space
# Публичный адрес картинок товаров и каталог для них на хосте
PUBLIC_MEDIA_URL=https://mirari.space/media/
MEDIA_DIR=/home/deploy/mirari-media
YANDEX_METRIKA_ID=
YANDEX_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
INDEXNOW_KEY=
