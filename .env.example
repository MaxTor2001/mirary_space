# Скопируйте в .env и поменяйте значения для production
POSTGRES_DB=mirari
POSTGRES_USER=mirari
POSTGRES_PASSWORD=mirari
POSTGRES_PORT_HOST=5432

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=
BACKEND_PORT=8000
SEED_DEMO=1
# Пароль администратора для seed_demo; без него будет admin/admin
DJANGO_ADMIN_PASSWORD=change-me
# Адрес админки. На проде задайте неугадываемый путь и тот же путь укажите
# в ADMIN_URL и в location nginx. Слеш в конце обязателен.
DJANGO_ADMIN_PATH=admin/
ADMIN_URL=/admin/

# Реквизиты продавца (показываются на страницах «О магазине» и «Контакты»)
SHOP_LEGAL_NAME=ИП Канищева Екатерина Владимировна
SHOP_INN=745110010453

SESSION_SECRET=change-me
FRONTEND_PORT=3000

# Только для docker-compose.prod.yml: порт витрины, интерфейс и Secure-куки за nginx
SHOP_PUBLIC_PORT=8080
SHOP_BIND=127.0.0.1
SECURE_COOKIES=1

# SEO: абсолютный адрес сайта, счётчик Метрики, подтверждения владения, ключ IndexNow
SITE_URL=https://mirari.space
YANDEX_METRIKA_ID=
YANDEX_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
INDEXNOW_KEY=
